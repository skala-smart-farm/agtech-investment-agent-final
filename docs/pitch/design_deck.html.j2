<script>
document.querySelectorAll('.reveal .slides > section').forEach(function (s) {
  var d = document.createElement('div'); d.className = 'in';
  Array.prototype.slice.call(s.childNodes).forEach(function (c) { if (c.tagName !== 'ASIDE') d.appendChild(c); });
  s.insertBefore(d, s.firstChild);
  if (s.classList.contains('cover')) return;
  // 제목(kick·h2) 아래 남는 영역의 세로 가운데에 본문을 둔다 (위로 몰리고 아래가 비는 것을 막음)
  var box = document.createElement('div'); box.className = 'content';
  Array.prototype.slice.call(d.childNodes).forEach(function (c) {
    if (c.nodeType !== 1) return;
    if (c.classList.contains('kick') || c.tagName === 'H2' || c.classList.contains('src') || c.classList.contains('pg')) return;
    box.appendChild(c);
  });
  var h2 = d.querySelector('h2'); if (h2) h2.after(box); else d.appendChild(box);
});
mermaid.initialize({startOnLoad:false, theme:"neutral", securityLevel:"loose",
  themeVariables:{fontFamily:"Pretendard, sans-serif", fontSize:"15px"},
  flowchart:{htmlLabels:true, curve:"basis", nodeSpacing:22, rankSpacing:26, padding:6, wrappingWidth:240}});
function startDeck() {
  Reveal.initialize({ width:1280, height:720, margin:0, minScale:0.2, maxScale:2, center:false, hash:true, controls:true, progress:true,
    transition:"fade", pdfMaxPagesPerSlide:1, pdfSeparateFragments:false, plugins:[RevealNotes] });
}
// 숨겨진 슬라이드 안에서는 mermaid 가 크기를 잴 수 없어, 먼저 SVG 로 그려 넣은 뒤 reveal 을 시작한다
async function renderMermaid() {
  var els = Array.prototype.slice.call(document.querySelectorAll('pre.mermaid'));
  for (var i = 0; i < els.length; i++) {
    try { var r = await mermaid.render('mm' + i, els[i].textContent); els[i].innerHTML = r.svg; els[i].setAttribute('data-processed', 'true'); }
    catch (e) { console.error('mermaid', e); }
  }
}
renderMermaid().then(startDeck, startDeck);
</script>
