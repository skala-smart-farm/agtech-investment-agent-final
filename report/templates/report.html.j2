<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pretendard@1.3.9/dist/web/static/pretendard.css">
{# 보고서 view(agents/report.py): summary [(라벨, 문장)], chapters [{title, lead, blocks}], ref_groups.
   블록 종류: p(문단) · note(작은 규칙·설명 줄) · kv(굵은 라벨 목록) · ul(목록) · table(표) · h3(소제목) ·
   cand(후보별 보류 사유 4줄) · box(ROI 참고치). density 0~3 은 5쪽을 넘을 때 조판 밀도를 올리는 단계다 #}
{% set fs = [10.0, 9.5, 9.0, 8.6][density] %}
{% set lh = [1.52, 1.47, 1.42, 1.37][density] %}
<style>
  @page { size: A4; }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: "Pretendard", "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans CJK KR", sans-serif;
         font-size: {{ fs }}pt; line-height: {{ lh }}; color: #1b2330; }
  h1 { font-size: 14.5pt; margin: 0 0 2pt; color: #12213f; letter-spacing: -0.02em; }
  .meta { font-size: 8.3pt; color: #667085; margin-bottom: 8pt; }
  .badge { display: inline-block; padding: 1pt 8pt; border-radius: 10pt; font-weight: 800; font-size: 9pt; color: #fff;
           background: {{ '#12806b' if mode == 'invest' else '#b8650a' }}; margin-left: 6pt; vertical-align: 2pt; }
  h2 { font-size: {{ fs + 2 }}pt; color: #12213f; margin: {{ [11, 9, 8, 7][density] }}pt 0 3pt; padding-bottom: 2pt;
       border-bottom: 1.5pt solid #d8dee9; break-after: avoid; }
  h3 { font-size: {{ fs + 0.4 }}pt; color: #12213f; margin: 6pt 0 2pt; break-after: avoid; }
  h4 { font-size: {{ fs - 0.8 }}pt; color: #475467; margin: 4pt 0 1pt; break-after: avoid; }
  p { margin: 2pt 0 4pt; text-align: justify; }
  p.lead { font-weight: 800; color: #12213f; margin: 1pt 0 4pt; }
  p.note { font-size: {{ fs - 1.3 }}pt; color: #344054; margin: 1pt 0 2pt; }
  #summary { border: 1.6pt solid #12213f; border-radius: 6pt; padding: 7pt 11pt 6pt; background: #f5f7fb; }
  #summary h2 { margin-top: 0; border: none; font-size: 11pt; letter-spacing: 0.08em; }
  #summary ul { margin: 0; padding-left: 13pt; }
  #summary li { margin: 1.5pt 0; }
  #summary li.conclusion { font-weight: 800; }
  ul.kv, ul.plain { margin: 2pt 0 4pt; padding-left: 14pt; } ul.kv li, ul.plain li { margin: 1.5pt 0; }
  .ul-title { font-size: {{ fs - 0.8 }}pt; font-weight: 700; color: #475467; margin: 4pt 0 0; }
  table { width: 100%; border-collapse: collapse; font-size: {{ fs - 1.2 }}pt; margin: 4pt 0 6pt; break-inside: auto; }
  table.small { font-size: {{ fs - 1.6 }}pt; }
  th, td { border: 0.6pt solid #cfd6e2; padding: 2.2pt 4.5pt; vertical-align: top; text-align: left; }
  th { background: #eef2f8; font-weight: 700; }
  tr { break-inside: avoid; }
  thead { display: table-header-group; }
  .cand { border-left: 2.5pt solid #b8650a; padding: 1pt 0 1pt 7pt; margin: 4pt 0 5pt; break-inside: avoid; }
  .cand h3 { margin-top: 0; }
  .cand ul { margin: 1pt 0; padding-left: 12pt; } .cand li { margin: 0.8pt 0; }
  .box { border: 1pt solid #9aa7bd; border-radius: 4pt; padding: 3pt 8pt; margin: 4pt 0 6pt; background: #fafbfd; break-inside: avoid; }
  .box .box-title { font-weight: 800; font-size: {{ fs - 0.6 }}pt; color: #12213f; }
  .box ul { margin: 1pt 0; padding-left: 12pt; font-size: {{ fs - 1.2 }}pt; }
  .small { font-size: {{ fs - 1.4 }}pt; color: #475467; }
  ol.refs { font-size: {{ fs - 1.8 }}pt; padding-left: 16pt; margin: 1pt 0 3pt; word-break: break-all; }
  ol.refs li { margin: 1pt 0; }
</style>
</head>
<body>
{% macro block(b) %}
  {% if b.t == 'p' %}<p>{{ b.text }}</p>
  {% elif b.t == 'note' %}<p class="note">{{ b.text }}</p>
  {% elif b.t == 'kv' %}<ul class="kv">{% for k, v in b['items'] %}<li><b>{{ k }}</b> {{ v }}</li>{% endfor %}</ul>
  {% elif b.t == 'ul' %}{% if b.title %}<div class="ul-title">{{ b.title }}</div>{% endif %}<ul class="plain">{% for x in b['items'] %}<li>{{ x }}</li>{% endfor %}</ul>
  {% elif b.t == 'h3' %}<h3>{{ b.text }}</h3>
  {% elif b.t == 'table' %}
  <table class="{{ 'small' if b.small else '' }}">
    <thead><tr>{% for h in b.head %}<th{% if b.widths and b.widths[loop.index0] %} style="width:{{ b.widths[loop.index0] }}"{% endif %}>{{ h }}</th>{% endfor %}</tr></thead>
    {% for r in b.rows %}<tr>{% for c in r %}<td>{{ c }}</td>{% endfor %}</tr>{% endfor %}
  </table>
  {% elif b.t == 'cand' %}
  <div class="cand">
    <h3>{{ b.title }} <span class="small">({{ b.sub }})</span></h3>
    <ul>{% for k, v in b['items'] %}<li><b>{{ k }}</b> {{ v }}</li>{% endfor %}</ul>
  </div>
  {% elif b.t == 'box' %}
  <div class="box"><div class="box-title">{{ b.title }}</div>
    <ul>{% for k, v in b['items'] %}<li><b>{{ k }}</b> {{ v }}</li>{% endfor %}</ul></div>
  {% endif %}
{% endmacro %}
  <h1>{{ title }}<span class="badge">{{ badge }}</span></h1>
  <div class="meta">{{ meta }}</div>

  <section id="summary">
    <h2>SUMMARY</h2>
    <ul>{% for k, s in summary %}<li{% if k == '결론' %} class="conclusion"{% endif %}><b>{{ k }}</b> {{ s }}</li>{% endfor %}</ul>
  </section>

  {% for ch in chapters %}
  <h2>{{ ch.title }}</h2>
  <p class="lead">{{ ch.lead }}</p>
  {% for b in ch.blocks %}{{ block(b) }}{% endfor %}
  {% endfor %}

  <h2>REFERENCE</h2>
  {% for g in ref_groups %}
  <h4>{{ g.name }}</h4>
  {% if g["items"] %}<ol class="refs">{% for r in g["items"] %}<li value="{{ r.n }}">{{ r.text }}</li>{% endfor %}</ol>
  {% else %}<p class="small">본문에 인용한 자료 없음</p>{% endif %}
  {% endfor %}
</body>
</html>
